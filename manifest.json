{
  "$schema": "https://eirafocus.com/schemas/manifest-v1.json",
  "manifest_version": 1,
  "content_version": "0.2.0",
  "updated_at": "2026-08-01",
  "description": "Top-level content bundle manifest. Apps pin a manifest_version (major) and lazily fetch content listed below. Audio files cached on first play.",
  "data": {
    "breathing_methods": "data/breathing_methods.json",
    "quotes":            "data/quotes.json",
    "tags":              "data/tags.json",
    "text_prompts":      "data/text_prompts.json"
  },
  "programs": {
    "guided_journeys": "programs/guided_journeys.json",
    "multi_day": "programs/multi_day.json"
  },
  "audio": {
    "legacy": {
      "tier": "legacy",
      "note": "v1 Flutter procedural/recorded sounds, kept for reference only. Will not ship in v2.0.",
      "files": [
        "audio/legacy/bell.mp3",
        "audio/legacy/creek.mp3",
        "audio/legacy/forest.mp3",
        "audio/legacy/rain.mp3"
      ]
    },
    "ambient": {
      "tier": "free_and_plus",
      "note": "Normalized ambient loops. Rain and Drift are free; the app gates the remaining six as Plus.",
      "files": [
        "audio/ambient/eira_ambient_rain.m4a",
        "audio/ambient/eira_ambient_drift.m4a",
        "audio/ambient/eira_ambient_stream.m4a",
        "audio/ambient/eira_ambient_ocean.m4a",
        "audio/ambient/eira_ambient_forest.m4a",
        "audio/ambient/eira_ambient_hearth.m4a",
        "audio/ambient/eira_ambient_night.m4a",
        "audio/ambient/eira_ambient_cavern.m4a"
      ]
    },
    "voice": {
      "tier": "free_and_plus",
      "note": "Voice narration is not part of the 2.0 release.",
      "files": []
    }
  },
  "branding": {
    "logo":         "branding/logo.png",
    "logo_no_bg":   "branding/logo-no-bg.png",
    "logo_white_bg": "branding/logo-white-bg.png"
  }
}
